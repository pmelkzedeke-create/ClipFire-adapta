# =============================================================================
# CLIPFIRE — CONFIGURAÇÕES DE AMBIENTE (BACKEND)
# Mantenha todas as chaves e segredos exclusivamente no servidor.
# =============================================================================

# Chave de API da Groq (opcional — ativa transcrição real via Groq Whisper + análise LLaMA-3.3)
# Obtenha em https://console.groq.com/keys
GROQ_API_KEY=""

# Chave Gemini AI (opcional)
GEMINI_API_KEY=""

# URL pública da aplicação
APP_URL="http://localhost:3000"

# =============================================================================
# FFMPEG & PROCESSAMENTO DE VÍDEO REAL
# =============================================================================

# Caminhos explícitos dos binários (opcional — se vazio, detecta automaticamente no PATH ou pacote nativo)
FFMPEG_PATH=""
FFPROBE_PATH=""

# Diretório temporário e de execução local (fora do repositório Git)
CLIPFIRE_RUNTIME_DIR="/tmp/clipfire-runtime"

# Limites de segurança, CPU e memória
MAX_UPLOAD_SIZE_MB="500"
MAX_VIDEO_DURATION_SEC="7200"
MAX_CLIPS_PER_JOB="15"
MAX_CONCURRENT_JOBS="2"
MAX_FFMPEG_CONCURRENCY="2"
FFMPEG_THREADS_PER_PROC="2"
FFMPEG_CLIP_TIMEOUT_MS="300000"
JOB_RETENTION_TTL_MS="7200000"

# Segredo HMAC-SHA256 para URLs assinadas de prévia e download (gere uma string aleatória longa em produção)
MEDIA_SIGNING_SECRET=""
SIGNED_URL_TTL_SEC="7200"

# =============================================================================
# ARMAZENAMENTO DE OBJETOS (S3 / CLOUDFLARE R2 / MINIO / SUPABASE) — PRODUÇÃO
# =============================================================================

# "local" (padrão para servidor dedicado/container) ou "s3" (recomendado para produção/serverless)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# =============================================================================
# WORKER EXTERNO DE RENDERIZAÇÃO (OPCIONAL PARA AMBIENTES SERVERLESS)
# =============================================================================

# "local_worker" (executa FFmpeg neste servidor) ou "remote_worker" (delega para worker dedicado)
PROCESSING_MODE="local_worker"
REMOTE_WORKER_URL=""
WORKER_SHARED_SECRET=""

# Token opcional de acesso autorizado à API do Google Drive (para importação autorizada de mídia)
GOOGLE_DRIVE_ACCESS_TOKEN=""

# =============================================================================
# PAINEL ADMIN DE SEGURANÇA MÁXIMA (OPCIONAL — SE VAZIO, USA BOOTSTRAP LOCK NO 1º ACESSO)
# =============================================================================
ADMIN_MASTER_EMAIL=""
ADMIN_MASTER_PASSWORD=""
ADMIN_MASTER_PIN=""

